{
  "id": "adaptlypost",
  "name": "AdaptlyPost",
  "description": "Schedule and publish social posts to LinkedIn, X, Instagram, Facebook, TikTok, YouTube, Pinterest, Threads, Bluesky, Mastodon, Google Business Profile, Telegram, Tumblr and WordPress from OpenClaw, read how they performed, and read and answer comments, mentions, direct messages and Google reviews.",
  "version": "0.28.0",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiToken": {
        "type": "string",
        "description": "AdaptlyPost API token (adaptly_...). Create a dedicated, revocable one at https://adaptlypost.com under Settings then API Tokens."
      },
      "mediaDirs": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Folders the agent may upload local media from, such as ~/Pictures/social. Files outside them, hidden files and non-media files are refused. Leave empty to allow URL uploads only."
      }
    },
    "required": [
      "apiToken"
    ]
  },
  "contracts": {
    "tools": [
      "adaptlypost_accounts",
      "adaptlypost_check_account",
      "adaptlypost_remove_account",
      "adaptlypost_search_instagram_audio",
      "adaptlypost_list_pinterest_boards",
      "adaptlypost_list_wordpress_categories",
      "adaptlypost_resolve_linkedin_organization",
      "adaptlypost_upload_media",
      "adaptlypost_create_post",
      "adaptlypost_validate_post",
      "adaptlypost_list_posts",
      "adaptlypost_post_results",
      "adaptlypost_retry_failed",
      "adaptlypost_unschedule_post",
      "adaptlypost_list_recurring_posts",
      "adaptlypost_get_recurring_post",
      "adaptlypost_pause_recurring_post",
      "adaptlypost_resume_recurring_post",
      "adaptlypost_delete_recurring_post",
      "adaptlypost_analytics_overview",
      "adaptlypost_post_analytics",
      "adaptlypost_inbox_summary",
      "adaptlypost_refresh_inbox",
      "adaptlypost_list_inbox_comments",
      "adaptlypost_get_inbox_comment",
      "adaptlypost_reply_inbox_comment",
      "adaptlypost_hide_inbox_comment",
      "adaptlypost_unhide_inbox_comment",
      "adaptlypost_like_inbox_comment",
      "adaptlypost_unlike_inbox_comment",
      "adaptlypost_delete_inbox_comment",
      "adaptlypost_update_inbox_comments_status",
      "adaptlypost_list_inbox_mentions",
      "adaptlypost_reply_inbox_mention",
      "adaptlypost_update_inbox_mentions_status",
      "adaptlypost_list_inbox_conversations",
      "adaptlypost_get_inbox_conversation",
      "adaptlypost_send_inbox_message",
      "adaptlypost_update_inbox_conversations_status",
      "adaptlypost_list_inbox_reviews",
      "adaptlypost_reply_inbox_review",
      "adaptlypost_delete_inbox_review_reply",
      "adaptlypost_update_inbox_reviews_status"
    ]
  },
